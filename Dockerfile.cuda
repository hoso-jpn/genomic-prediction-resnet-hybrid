# CUDA実行環境（GPU比較実験用）
#
# 既定のCPUイメージ（Dockerfile）とは別のイメージ。依存関係は
# cuda/pyproject.toml と cuda/uv.lock で固定し、ルートの uv.lock と
# CIの既定経路には影響させない。
#
# CUDA runtime / cuDNN は cuda/uv.lock で固定した nvidia-* wheel が提供する
# ため、ベースイメージはCPU版と同じ python:3.11-slim を使う（数値計算まわりの
# 依存差を減らし、CPU実行との比較条件を揃えるため）。ホスト側には NVIDIA
# driver と NVIDIA Container Toolkit が必要。
#
# 実機での動作確認状況は docs/gpu-verification.md を参照。
FROM python:3.11-slim

ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    UV_PROJECT_ENVIRONMENT=/opt/venv \
    PATH="/opt/venv/bin:${PATH}" \
    GPRH_ENVIRONMENT=cuda-12.1-torch-2.2.1

# uv: バージョンを固定して導入する（CPUイメージ・CIと同一バージョン）
COPY --from=ghcr.io/astral-sh/uv:0.12.3 /uv /uvx /usr/local/bin/

WORKDIR /workspace

# CUDA用の依存定義だけを先にCOPYし、ソース変更時もこのレイヤーをキャッシュさせる
COPY cuda/pyproject.toml cuda/uv.lock ./cuda/
RUN uv sync --frozen --dev --no-cache --project cuda

# 検証済みソースコードとテストを含むリポジトリ全体をイメージへ配置する
COPY . .

CMD ["bash"]
